    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst sheetItems = $('Code in JavaScript').all();\nconst output = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const input = items[i].json;\n\n  // Get the AI response\n  let aiText = input.text || input.output || input.response || '';\n\n  // Remove markdown code fences if Gemini adds them\n  aiText = aiText\n    .replace(/```json/g, '')\n    .replace(/```/g, '')\n    .trim();\n\n  const evaluation = JSON.parse(aiText);\n\n  // Recommendation logic from the assignment\n  const recommendation =\n    evaluation.technical_skill_match >= 7 &&\n    evaluation.experience_relevance >= 6\n      ? 'Recommended'\n      : 'Not Recommended';\n\n  // Identity comes from the sheet row (paired by index), not the resume text,\n  // so the email/sheet always match the actual applicant.\n  const sheetRow = (sheetItems[i] && sheetItems[i].json) || {};\n\n  output.push({\n    json: {\n      name: sheetRow.name || evaluation.name,\n      email: sheetRow.email || '',\n      timestamp: sheetRow.timestamp || '',\n      role_category: evaluation.role_category,\n      technical_skills: (evaluation.technical_skills || []).join(', '),\n\n      technical_skill_match: evaluation.technical_skill_match,\n      experience_relevance: evaluation.experience_relevance,\n      communication_quality: evaluation.communication_quality,\n      education_quality: evaluation.education_quality,\n\n      education_category: evaluation.education_category,\n      highest_degree: evaluation.highest_degree,\n      college: evaluation.college,\n\n      final_score:\n        (\n          evaluation.technical_skill_match * 0.4 +\n          evaluation.experience_relevance * 0.3 +\n          evaluation.communication_quality * 0.2 +\n          evaluation.education_quality * 0.1\n        ).toFixed(2),\n\n      recommendation: recommendation,\n\n      summary: evaluation.summary,\n      strengths: (evaluation.strengths || []).join(', '),\n      gaps: (evaluation.gaps || []).join(', ')\n    },\n    pairedItem: { item: i }\n  });\n}\n\nreturn output;"
      },
