    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (let i = 0; i < items.length; i++) {\n  // Normalize keys: header cells in the sheet have padding spaces\n  // (e.g. \"  Resume  \"), so build a trimmed-key lookup.\n  const row = {};\n  for (const key of Object.keys(items[i].json)) {\n    row[key.trim()] = items[i].json[key];\n  }\n\n  const resume = String(row['Resume'] || '').trim();\n\n  let fileId = null;\n\n  let match = resume.match(/\\/d\\/([a-zA-Z0-9_-]+)/);\n  if (match) fileId = match[1];\n\n  if (!fileId) {\n    match = resume.match(/[?&]id=([a-zA-Z0-9_-]+)/);\n    if (match) fileId = match[1];\n  }\n\n  if (!fileId && /^[a-zA-Z0-9_-]{20,}$/.test(resume)) {\n    fileId = resume;\n  }\n\n  output.push({\n    json: {\n      name: row['Name'],\n      email: row['Email'],\n      linkedin: row['LinkedIn URL'],\n      techStack: row['Tech Stack'],\n      resume: resume,\n      fileId: fileId,\n      timestamp: row['Timestamp'],\n      rowNumber: row.row_number\n    },\n    pairedItem: { item: i }\n  });\n}\n\nreturn output;"
      },
